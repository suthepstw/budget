{
  "name": "budget",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "dev:pages": "npm run build && wrangler pages dev dist --port 8788",
    "db:migrate:local": "wrangler d1 migrations apply budget-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply budget-db --remote",
    "deploy": "npm run build && wrangler pages deploy dist",
    "test": "wrangler pages functions build --outdir=.wrangler/test-worker --compatibility-date=2026-10-03 --compatibility-flags=nodejs_compat && node --test tests/*.test.mjs"
  },
  "dependencies": {
    "chart.js": "^4.5.1",
    "chartjs-plugin-datalabels": "^2.2.0",
    "sweetalert2": "^11.26.25",
    "vue": "^3.5.42",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "miniflare": "^5.20261001.0-alpha",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.0",
    "wrangler": "^4.147.0"
  }
}
